@page "/operation-detail"
@namespace MongoSpyglass.Service.Pages

<div class="flex-1 overflow-y-auto bg-surface-lowest flex flex-col p-container-padding gap-gutter">
    <!-- Context Header -->
    <div class="flex flex-col gap-1 pb-2 border-b border-outline-variant">
        <div class="flex justify-between items-start">
            <div class="flex flex-col">
                <h1 class="font-ui-header text-ui-header text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">data_object</span>
                    Operation <span class="font-display-mono text-display-mono text-primary-fixed-dim">#OP-8921-XF</span>
                </h1>
                <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-widest mt-1">
                    users_collection • 2023-10-27T14:32:01.450Z
                </span>
            </div>
            <div class="flex items-center gap-2">
                <button class="h-7 px-3 flex items-center gap-2 rounded bg-surface-container border border-outline-variant text-on-surface-variant hover:bg-surface-container-high transition-colors text-[12px] font-medium">
                    <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    Copy ID
                </button>
                <button class="h-7 px-3 flex items-center gap-2 rounded bg-primary text-on-primary hover:bg-primary-fixed transition-colors text-[12px] font-medium">
                    <span class="material-symbols-outlined text-[16px]">download</span>
                    Export JSON
                </button>
            </div>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter flex-1 items-start h-full pb-8">

        <!-- Left Main Panel: Query/Explain (Span 8) -->
        <div class="lg:col-span-8 flex flex-col h-full gap-unit min-h-[600px]">
            <!-- IDE Tabs -->
            <div class="flex items-end border-b border-outline-variant px-2 gap-1 pt-1">
                <div class="px-4 py-2 bg-surface-container border border-outline-variant border-b-0 rounded-t border-b-2 !border-b-primary text-primary font-ui-label-sm text-ui-label-sm cursor-pointer flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px]">code</span>
                    Query
                </div>
                <div class="px-4 py-2 border border-transparent border-b-0 rounded-t text-on-surface-variant font-ui-label-sm text-ui-label-sm cursor-pointer hover:bg-surface-container-low transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px]">account_tree</span>
                    Explain
                </div>
            </div>

            <!-- Code Editor Panel -->
            <div class="flex-1 bg-surface-container rounded-b rounded-tr border border-outline-variant border-t-0 flex flex-col overflow-hidden relative">
                <!-- Toolbar -->
                <div class="h-8 border-b border-outline-variant bg-surface-container-high flex items-center px-3 justify-between">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-secondary inline-block"></span> Find Command
                    </span>
                    <div class="flex items-center gap-2 text-on-surface-variant">
                        <span class="material-symbols-outlined text-[16px] cursor-pointer hover:text-on-surface">wrap_text</span>
                        <span class="material-symbols-outlined text-[16px] cursor-pointer hover:text-on-surface">content_copy</span>
                    </div>
                </div>
                <!-- Syntax Highlighted Block -->
                <pre class="flex-1 overflow-auto p-4 font-code-block text-code-block leading-relaxed bg-[#0F1420] text-on-surface"><code class="block"><span class="text-tertiary">{</span>
  <span class="text-primary-fixed-dim">"find"</span><span class="text-on-surface">:</span> <span class="text-secondary-fixed">"users"</span><span class="text-on-surface">,</span>
  <span class="text-primary-fixed-dim">"filter"</span><span class="text-on-surface">:</span> <span class="text-tertiary">{</span>
    <span class="text-primary-fixed-dim">"status"</span><span class="text-on-surface">:</span> <span class="text-secondary-fixed">"active"</span><span class="text-on-surface">,</span>
    <span class="text-primary-fixed-dim">"last_login"</span><span class="text-on-surface">:</span> <span class="text-tertiary">{</span>
      <span class="text-error">"$gte"</span><span class="text-on-surface">:</span> <span class="text-secondary-fixed">ISODate("2023-01-01T00:00:00Z")</span>
    <span class="text-tertiary">}</span><span class="text-on-surface">,</span>
    <span class="text-primary-fixed-dim">"organization_id"</span><span class="text-on-surface">:</span> <span class="text-secondary-fixed">ObjectId("64e3f8a9b2c1a45d7f8e90a1")</span>
  <span class="text-tertiary">}</span><span class="text-on-surface">,</span>
  <span class="text-primary-fixed-dim">"sort"</span><span class="text-on-surface">:</span> <span class="text-tertiary">{</span>
    <span class="text-primary-fixed-dim">"created_at"</span><span class="text-on-surface">:</span> <span class="text-tertiary-fixed">-1</span>
  <span class="text-tertiary">}</span><span class="text-on-surface">,</span>
  <span class="text-primary-fixed-dim">"projection"</span><span class="text-on-surface">:</span> <span class="text-tertiary">{</span>
    <span class="text-primary-fixed-dim">"password_hash"</span><span class="text-on-surface">:</span> <span class="text-tertiary-fixed">0</span><span class="text-on-surface">,</span>
    <span class="text-primary-fixed-dim">"internal_notes"</span><span class="text-on-surface">:</span> <span class="text-tertiary-fixed">0</span>
  <span class="text-tertiary">}</span><span class="text-on-surface">,</span>
  <span class="text-primary-fixed-dim">"limit"</span><span class="text-on-surface">:</span> <span class="text-tertiary-fixed">50</span>
<span class="text-tertiary">}</span></code></pre>
            </div>
        </div>

        <!-- Right Sidebar: Metrics & Warnings (Span 4) -->
        <div class="lg:col-span-4 flex flex-col gap-gutter h-full">
            <!-- CRITICAL: Warnings Section -->
            <div class="bg-error-container border border-error/50 rounded flex flex-col overflow-hidden relative">
                <div class="absolute top-0 left-0 w-1 h-full bg-error"></div>
                <div class="p-3 border-b border-error/20 flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px] text-error">warning</span>
                    <span class="font-ui-label-sm text-ui-label-sm text-on-error-container uppercase tracking-wide">Performance Warning</span>
                </div>
                <div class="p-4 flex flex-col gap-2">
                    <div class="flex items-baseline gap-2">
                        <span class="font-display-mono text-display-mono font-bold text-error">COLLSCAN</span>
                    </div>
                    <p class="font-ui-body text-ui-body text-on-error-container leading-snug">
                        Full collection scan detected. The query executor was unable to use an index to fulfill the <code class="font-code-block text-[11px] bg-error/20 px-1 rounded">filter</code> criteria.
                    </p>
                    <div class="mt-2 text-[11px] font-ui-label-sm text-error flex items-center gap-1 cursor-pointer hover:underline">
                        <span class="material-symbols-outlined text-[14px]">lightbulb</span>
                        Suggestion: Add index on { status: 1, organization_id: 1 }
                    </div>
                </div>
            </div>

            <!-- Performance Metrics Bento Grid -->
            <div class="bg-surface-container border border-outline-variant rounded flex flex-col">
                <div class="p-3 border-b border-outline-variant bg-surface-container-high">
                    <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider flex items-center gap-2">
                        <span class="material-symbols-outlined text-[14px]">speed</span>
                        Execution Metrics
                    </h3>
                </div>
                <div class="grid grid-cols-2 gap-[1px] bg-outline-variant">
                    <!-- Metric: Time -->
                    <div class="bg-surface-container p-4 flex flex-col gap-1">
                        <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Execution Time</span>
                        <div class="flex items-baseline gap-1">
                            <span class="font-display-mono text-[24px] font-medium text-error leading-none">1,452</span>
                            <span class="font-display-mono text-[12px] text-on-surface-variant">ms</span>
                        </div>
                    </div>
                    <!-- Metric: Planning Time -->
                    <div class="bg-surface-container p-4 flex flex-col gap-1">
                        <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Planning Time</span>
                        <div class="flex items-baseline gap-1">
                            <span class="font-display-mono text-[24px] font-medium text-primary-fixed-dim leading-none">3</span>
                            <span class="font-display-mono text-[12px] text-on-surface-variant">ms</span>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-[1px] bg-outline-variant border-t border-outline-variant">
                    <!-- Metric: Docs -->
                    <div class="bg-surface-container p-4 flex flex-col gap-3">
                        <div class="flex justify-between items-center">
                            <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Documents Examined</span>
                            <span class="font-display-mono text-display-mono text-on-surface">1,245,901</span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden">
                            <div class="h-full bg-error w-full"></div>
                        </div>
                        <div class="flex justify-between items-center mt-2">
                            <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Documents Returned</span>
                            <span class="font-display-mono text-display-mono text-on-surface">50</span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden">
                            <div class="h-full bg-secondary w-[1%]"></div>
                        </div>
                        <div class="mt-2 pt-2 border-t border-outline-variant/50 flex justify-between items-center">
                            <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Ratio (Examined / Returned)</span>
                            <span class="font-display-mono text-display-mono text-error font-bold">24,918 : 1</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mini Explain Plan Summary -->
            <div class="bg-surface-container border border-outline-variant rounded flex flex-col flex-1">
                <div class="p-3 border-b border-outline-variant bg-surface-container-high flex justify-between items-center">
                    <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider flex items-center gap-2">
                        <span class="material-symbols-outlined text-[14px]">account_tree</span>
                        Plan Summary
                    </h3>
                    <span class="text-[10px] uppercase text-primary border border-primary/30 px-1.5 rounded">Stages</span>
                </div>
                <div class="p-0 flex flex-col overflow-y-auto">
                    <!-- Dense Table Layout for Plan -->
                    <div class="flex items-center px-3 py-2 border-b border-outline-variant/30 hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-[16px] text-error mr-2">search</span>
                        <div class="flex flex-col flex-1">
                            <span class="font-code-block text-[12px] text-on-surface">COLLSCAN</span>
                            <span class="font-ui-label-sm text-[10px] text-on-surface-variant">users</span>
                        </div>
                        <span class="font-display-mono text-[11px] text-on-surface-variant">~1.2M docs</span>
                    </div>
                    <div class="flex items-center px-3 py-2 border-b border-outline-variant/30 hover:bg-surface-container-high transition-colors pl-6 relative">
                        <div class="absolute left-[19px] top-0 bottom-1/2 border-l border-b border-outline-variant w-3 h-1/2"></div>
                        <span class="material-symbols-outlined text-[16px] text-tertiary mr-2">filter_alt</span>
                        <div class="flex flex-col flex-1">
                            <span class="font-code-block text-[12px] text-on-surface">FILTER</span>
                            <span class="font-ui-label-sm text-[10px] text-on-surface-variant">status, last_login</span>
                        </div>
                        <span class="font-display-mono text-[11px] text-on-surface-variant">50 docs</span>
                    </div>
                    <div class="flex items-center px-3 py-2 hover:bg-surface-container-high transition-colors pl-10 relative">
                        <div class="absolute left-[43px] top-0 bottom-1/2 border-l border-b border-outline-variant w-3 h-1/2"></div>
                        <span class="material-symbols-outlined text-[16px] text-primary mr-2">sort</span>
                        <div class="flex flex-col flex-1">
                            <span class="font-code-block text-[12px] text-on-surface">SORT</span>
                            <span class="font-ui-label-sm text-[10px] text-on-surface-variant">created_at: -1</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
