@page "/operation-detail"
@using MongoSpyglass.Service.Data
@namespace MongoSpyglass.Service.Pages

<div class="flex-1 overflow-y-auto bg-surface-lowest flex flex-col p-container-padding gap-gutter">
    <!-- Context Header -->
    <div class="flex flex-col gap-1 pb-2 border-b border-outline-variant">
        <div class="flex justify-between items-start">
            <div class="flex flex-col">
                <h1 class="font-ui-header text-ui-header text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px] text-primary">data_object</span>
                    Operation <span class="font-display-mono text-display-mono text-primary-fixed-dim">#@Entry.RequestId</span>
                </h1>
                <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-widest mt-1">
                    @Entry.Collection • @Entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")
                </span>
            </div>
            <div class="flex items-center gap-2">
                <button class="h-7 px-3 flex items-center gap-2 rounded bg-surface-container border border-outline-variant text-on-surface-variant text-[12px] font-medium">
                    <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    Copy ID
                </button>
                <button class="h-7 px-3 flex items-center gap-2 rounded bg-primary text-on-primary text-[12px] font-medium">
                    <span class="material-symbols-outlined text-[16px]">download</span>
                    Export JSON
                </button>
            </div>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter flex-1 items-start h-full pb-8">

        <!-- Left Main Panel: Query/Explain (Span 8) -->
        <div class="lg:col-span-8 flex flex-col h-full gap-unit min-h-[600px]">
            <!-- IDE Tabs -->
            <div class="flex items-end border-b border-outline-variant px-2 gap-1 pt-1">
                <div class="px-4 py-2 bg-surface-container border border-outline-variant border-b-0 rounded-t border-b-2 !border-b-primary text-primary font-ui-label-sm text-ui-label-sm cursor-pointer flex items-center gap-2">
                    <span class="material-symbols-outlined text-[14px]">code</span>
                    Payload
                </div>
            </div>

            <!-- Code Editor Panel -->
            <div class="flex-1 bg-surface-container rounded-b rounded-tr border border-outline-variant border-t-0 flex flex-col overflow-hidden relative">
                <!-- Toolbar -->
                <div class="h-8 border-b border-outline-variant bg-surface-container-high flex items-center px-3 justify-between">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-secondary inline-block"></span> @Entry.Command Command
                    </span>
                </div>
                <!-- Syntax Highlighted Block (Simple Pre for now) -->
                <pre class="flex-1 overflow-auto p-4 font-code-block text-code-block leading-relaxed bg-[#0F1420] text-on-surface"><code class="block">@Entry.PayloadJson</code></pre>
            </div>
        </div>

        <!-- Right Sidebar: Metrics & Warnings (Span 4) -->
        <div class="lg:col-span-4 flex flex-col gap-gutter h-full">
            <!-- Performance Metrics Bento Grid -->
            <div class="bg-surface-container border border-outline-variant rounded flex flex-col">
                <div class="p-3 border-b border-outline-variant bg-surface-container-high">
                    <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider flex items-center gap-2">
                        <span class="material-symbols-outlined text-[14px]">speed</span>
                        Execution Metrics
                    </h3>
                </div>
                <div class="grid grid-cols-2 gap-[1px] bg-outline-variant">
                    <!-- Metric: Time -->
                    <div class="bg-surface-container p-4 flex flex-col gap-1">
                        <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Duration</span>
                        <div class="flex items-baseline gap-1">
                            <span class="font-display-mono text-[24px] font-medium text-secondary leading-none">@(Entry.DurationMs?.ToString("F1") ?? "N/A")</span>
                            <span class="font-display-mono text-[12px] text-on-surface-variant">ms</span>
                        </div>
                    </div>
                    <!-- Metric: Size -->
                    <div class="bg-surface-container p-4 flex flex-col gap-1">
                        <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Size</span>
                        <div class="flex items-baseline gap-1">
                            <span class="font-display-mono text-[24px] font-medium text-primary-fixed-dim leading-none">@(Entry.SizeBytes < 1024 ? Entry.SizeBytes : (Entry.SizeBytes / 1024.0).ToString("F1"))</span>
                            <span class="font-display-mono text-[12px] text-on-surface-variant">@(Entry.SizeBytes < 1024 ? "B" : "KB")</span>
                        </div>
                    </div>
                </div>
                <div class="grid grid-cols-1 gap-[1px] bg-outline-variant border-t border-outline-variant">
                    <!-- Metric: Docs -->
                    <div class="bg-surface-container p-4 flex flex-col gap-3">
                        <div class="flex justify-between items-center">
                            <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant">Documents Returned</span>
                            <span class="font-display-mono text-display-mono text-on-surface">@Entry.DocumentCount</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Metadata Info -->
            <div class="bg-surface-container border border-outline-variant rounded flex flex-col flex-1 p-4 gap-4">
                 <div class="flex flex-col gap-1">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase">OpCode</span>
                    <span class="font-display-mono text-display-mono text-on-surface">@Entry.OpCode</span>
                 </div>
                 <div class="flex flex-col gap-1">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase">Request ID</span>
                    <span class="font-display-mono text-display-mono text-on-surface">@Entry.RequestId</span>
                 </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public DecryptedTraffic Entry { get; set; } = new();
}
