@page "/"
@using MongoSpyglass.Service.Data
@namespace MongoSpyglass.Service.Pages
@inject TrafficMonitorService TrafficMonitor
@inject DialogService DialogService
@implements IDisposable

<div class="flex flex-col flex-grow min-w-0">
    <div class="flex-grow overflow-y-auto overflow-x-hidden p-container-padding bg-background relative flex flex-col gap-gutter">
        <div class="grid grid-cols-12 gap-gutter shrink-0">
            <!-- Total Operations Card -->
            <div class="col-span-3 bg-surface-container rounded border border-outline-variant p-3 flex flex-col justify-between h-[110px] relative overflow-hidden group">
                <div class="flex justify-between items-start w-full z-10">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider">Total Operations</span>
                    <span class="material-symbols-outlined text-[16px] text-primary-fixed-dim">speed</span>
                </div>
                <div class="z-10 flex items-baseline gap-2">
                    <span class="font-display-mono text-display-mono text-[28px] text-primary-fixed">@_totalOps</span>
                </div>
            </div>

            <!-- Avg Execution Time Card -->
            <div class="col-span-3 bg-surface-container rounded border border-outline-variant p-3 flex flex-col justify-between h-[110px] relative overflow-hidden">
                <div class="flex justify-between items-start w-full z-10">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider">Avg Execution Time</span>
                    <span class="material-symbols-outlined text-[16px] text-tertiary-fixed-dim">timer</span>
                </div>
                <div class="z-10 flex items-baseline gap-2">
                    <span class="font-display-mono text-display-mono text-[28px] text-on-surface">@(_avgLatency?.ToString("F1") ?? "-")</span>
                    <span class="font-code-block text-[11px] text-on-surface-variant">ms</span>
                </div>
                <div class="w-full bg-surface-container-highest h-1 rounded-full mt-2 overflow-hidden z-10">
                    <div class="bg-tertiary-fixed-dim h-full" style="width: @(Math.Min((_avgLatency ?? 0) / 200 * 100, 100))%"></div>
                </div>
            </div>

            <!-- Max Latency Card -->
            <div class="col-span-3 bg-surface-container rounded border border-outline-variant p-3 flex flex-col justify-between h-[110px] relative overflow-hidden">
                <div class="flex justify-between items-start w-full z-10">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider">Max Latency</span>
                    <span class="material-symbols-outlined text-[16px] text-secondary-fixed">bolt</span>
                </div>
                <div class="z-10 flex items-baseline gap-2">
                    <span class="font-display-mono text-display-mono text-[28px] text-on-surface">@(_maxLatency?.ToString("F1") ?? "-")</span>
                    <span class="font-code-block text-[11px] text-on-surface-variant">ms</span>
                </div>
            </div>

            <!-- Events Captured Card -->
            <div class="col-span-3 bg-surface-container rounded border border-outline-variant p-3 flex flex-col justify-between h-[110px]">
                <div class="flex justify-between items-start w-full">
                    <span class="font-ui-label-sm text-ui-label-sm text-on-surface-variant uppercase tracking-wider">Captured Events</span>
                    <span class="material-symbols-outlined text-[16px] text-outline">history</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="font-display-mono text-display-mono text-[28px] text-on-surface">@_totalOps</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-12 gap-gutter shrink-0">
            <!-- Latency Chart -->
            <div class="col-span-8 bg-surface-container rounded border border-outline-variant flex flex-col h-[320px]">
                <div class="px-4 py-3 border-b border-outline-variant flex justify-between items-center bg-surface-container-low rounded-t">
                    <h2 class="font-ui-header text-ui-header text-on-surface">Operation Latency Distribution</h2>
                </div>
                <div class="p-4 flex-grow relative w-full h-full flex flex-col">
                    <RadzenChart>
                        <RadzenLineSeries Smooth="true" Data="@_latencyHistory" CategoryProperty="Timestamp" Title="Latency" LineType="LineType.Solid" ValueProperty="Latency">
                            <RadzenMarkers MarkerType="MarkerType.None" />
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis Padding="20" FormatString="{0:HH:mm:ss}" />
                        <RadzenValueAxis>
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="Latency (ms)" />
                        </RadzenValueAxis>
                    </RadzenChart>
                </div>
            </div>

            <!-- Top Commands -->
            <div class="col-span-4 bg-surface-container rounded border border-outline-variant flex flex-col h-[320px]">
                <div class="px-4 py-3 border-b border-outline-variant bg-surface-container-low rounded-t">
                    <h2 class="font-ui-header text-ui-header text-on-surface">Top Commands</h2>
                </div>
                <div class="p-4 flex flex-col gap-4 flex-grow overflow-y-auto font-code-block text-code-block">
                    @foreach (var cmd in _topCommands)
                    {
                        <div class="flex flex-col gap-1">
                            <div class="flex justify-between text-on-surface-variant text-[11px] uppercase tracking-wide font-ui-label-sm">
                                <span>@cmd.Key</span>
                                <span class="text-secondary-fixed">@cmd.Value</span>
                            </div>
                            <div class="w-full bg-surface-container-highest h-[2px] rounded-full mt-1">
                                <div class="bg-secondary-fixed h-full" style="width: @(cmd.Value * 100 / Math.Max(1, _totalOps))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Slow Queries -->
        <div class="bg-surface-container rounded border border-outline-variant flex flex-col flex-grow min-h-[200px]">
            <div class="px-4 py-3 border-b border-outline-variant bg-surface-container-low rounded-t flex justify-between items-center">
                <h2 class="font-ui-header text-ui-header text-on-surface">Recent Slow Queries (>100ms)</h2>
            </div>
            <div class="w-full overflow-x-auto p-2">
                <RadzenDataGrid Data="@_slowQueries" TItem="DecryptedTraffic" Density="Density.Compact" GridLines="DataGridGridLines.None" AllowPaging="false" AllowSorting="true" RowClick="@((DataGridRowMouseEventArgs<DecryptedTraffic> args) => ShowDetails(args.Data))" style="cursor: pointer;">
                    <Columns>
                        <RadzenDataGridColumn TItem="DecryptedTraffic" Property="Timestamp" Title="Time" FormatString="{0:HH:mm:ss}" Width="100px" />
                        <RadzenDataGridColumn TItem="DecryptedTraffic" Property="Collection" Title="Namespace" />
                        <RadzenDataGridColumn TItem="DecryptedTraffic" Property="Command" Title="Operation" Width="120px" />
                        <RadzenDataGridColumn TItem="DecryptedTraffic" Property="DurationMs" Title="Time" Width="100px">
                            <Template Context="q">
                                <span class="text-error font-medium">@q.DurationMs?.ToString("F1") ms</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="DecryptedTraffic" Property="SummaryJson" Title="Payload" />
                    </Columns>
                </RadzenDataGrid>
            </div>
        </div>
    </div>
</div>

@code {
    private int _totalOps = 0;
    private double? _avgLatency;
    private double? _maxLatency;
    private IEnumerable<KeyValuePair<string, int>> _topCommands = Enumerable.Empty<KeyValuePair<string, int>>();
    private IEnumerable<DecryptedTraffic> _slowQueries = Enumerable.Empty<DecryptedTraffic>();
    private List<LatencyPoint> _latencyHistory = new();

    protected override void OnInitialized()
    {
        TrafficMonitor.OnTrafficReceived += HandleTrafficReceived;
        RefreshMetrics();
    }

    private void RefreshMetrics()
    {
        var traffic = TrafficMonitor.Traffic;
        if (traffic == null) return;
        
        _totalOps = traffic.Count;
        
        var latencies = traffic.Where(t => t != null && t.DurationMs.HasValue).Select(t => t.DurationMs ?? 0).ToList();
        _avgLatency = latencies.Count > 0 ? latencies.Average() : null;
        _maxLatency = latencies.Count > 0 ? latencies.Max() : null;

        _topCommands = traffic
            .Where(t => t != null && !string.IsNullOrEmpty(t.Command))
            .GroupBy(t => t.Command)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(kv => kv.Value)
            .Take(5)
            .ToList();

        _slowQueries = traffic
            .Where(t => t != null && t.DurationMs > 100)
            .OrderByDescending(t => t.Timestamp)
            .Take(10)
            .ToList();

        _latencyHistory = traffic
            .Where(t => t != null && t.DurationMs.HasValue)
            .Reverse()
            .Take(20)
            .Reverse()
            .Select(t => new LatencyPoint { Timestamp = t.Timestamp, Latency = t.DurationMs ?? 0 })
            .ToList();
    }

    private async void HandleTrafficReceived()
    {
        RefreshMetrics();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowDetails(DecryptedTraffic entry)
    {
        await DialogService.OpenAsync<OperationDetail>($"Operation Detail: {entry.Command}",
            new Dictionary<string, object> { { "Entry", entry } },
            new DialogOptions 
            { 
                Width = "1100px", 
                Height = "800px", 
                Resizable = true, 
                Draggable = true,
                CloseDialogOnOverlayClick = true,
                CloseDialogOnEsc = true
            });
    }

    public void Dispose()
    {
        TrafficMonitor.OnTrafficReceived -= HandleTrafficReceived;
    }

    public class LatencyPoint
    {
        public DateTime Timestamp { get; set; }
        public double Latency { get; set; }
    }
}