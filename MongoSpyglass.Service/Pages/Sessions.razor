@page "/sessions"
@using MongoSpyglass.Service.Data
@inject RavenStorageService RavenService
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenContent Container="main">
    <ChildContent>
        <RadzenText Text="Session Management" TextStyle="TextStyle.H4" />
        
        <RadzenCard class="rz-my-4">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenTextBox Placeholder="Session Name..." @bind-Value="@_newSessionName" Style="width: 300px;" />
                <RadzenButton Text="Start New Session" Icon="add_circle" Click="@StartSession" ButtonStyle="ButtonStyle.Primary" />
            </RadzenStack>
        </RadzenCard>

        <RadzenDataGrid Data="@_sessions" TItem="MongoSession" AllowPaging="true" PageSize="10" AllowSorting="true" class="rz-shadow-2">
            <Columns>
                <RadzenDataGridColumn TItem="MongoSession" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="MongoSession" Property="StartTime" Title="Started" FormatString="{0:g}" />
                <RadzenDataGridColumn TItem="MongoSession" Property="IsActive" Title="Status">
                    <Template Context="session">
                        @if (session.IsActive)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Active" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Archived" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="MongoSession" Width="250px" TextAlign="TextAlign.Center">
                    <Template Context="session">
                        @if (!session.IsActive)
                        {
                            <RadzenButton Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" Text="Switch" Click="@(() => SwitchSession(session.Id))" class="rz-mr-2" />
                        }
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => DeleteSession(session))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenContent>

@code {
    private List<MongoSession> _sessions = new();
    private string _newSessionName = $"Session {DateTime.Now:yyyy-MM-dd HH:mm}";

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        _sessions = await RavenService.GetSessionsAsync();
    }

    private async Task StartSession()
    {
        if (string.IsNullOrWhiteSpace(_newSessionName))
        {
            return;
        }

        await RavenService.StartNewSessionAsync(_newSessionName);
        _newSessionName = $"Session {DateTime.Now:yyyy-MM-dd HH:mm}";
        await LoadSessions();
        
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Session Started", Detail = "New session is now active." });
    }

    private async Task SwitchSession(string id)
    {
        await RavenService.SwitchSessionAsync(id);
        await LoadSessions();
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Session Switched" });
    }

    private async Task DeleteSession(MongoSession session)
    {
        if (session.IsActive)
        {
            var result = await DialogService.OpenAsync("Delete Active Session", ds =>
                @<RadzenStack Gap="1.5rem">
                    <p>You are about to delete the active session. What would you like to do next?</p>
                    <RadzenButton Text="Start New Session" Click="() => ds.Close(1)" ButtonStyle="ButtonStyle.Primary" />
                    <RadzenButton Text="Switch to Existing" Click="() => ds.Close(2)" ButtonStyle="ButtonStyle.Secondary" />
                    <RadzenButton Text="Cancel" Click="() => ds.Close(0)" ButtonStyle="ButtonStyle.Light" />
                </RadzenStack>);

            if (result == null || (int)result == 0) return;

            if ((int)result == 1)
            {
                await StartSession();
            }
            else if ((int)result == 2)
            {
                var otherSession = _sessions.FirstOrDefault(x => x.Id != session.Id);
                if (otherSession != null)
                {
                    await RavenService.SwitchSessionAsync(otherSession.Id);
                }
                else
                {
                     NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "No other sessions", Detail = "Please start a new session first." });
                     return;
                }
            }
        }

        await RavenService.DeleteSessionAsync(session.Id);
        await LoadSessions();
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Session Deleted" });
    }
}
