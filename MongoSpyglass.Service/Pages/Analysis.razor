@page "/analysis"
@namespace MongoSpyglass.Service.Pages

<main class="flex-1 overflow-auto p-container-padding flex flex-col gap-gutter">
    <div class="flex justify-between items-end mb-unit">
        <div>
            <h2 class="font-ui-header text-ui-header text-on-surface">Performance Bottlenecks</h2>
            <p class="text-on-surface-variant mt-1 text-xs">Aggregated view of high-latency operations and indexing opportunities over the last 24 hours.</p>
        </div>
        <div class="flex gap-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-high border border-outline-variant rounded hover:bg-surface-variant transition-colors text-on-surface font-ui-label-sm text-ui-label-sm">
                <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                Last 24h
            </button>
            <button class="flex items-center gap-1.5 px-3 py-1.5 bg-primary/10 border border-primary/30 text-primary rounded hover:bg-primary/20 transition-colors font-ui-label-sm text-ui-label-sm">
                <span class="material-symbols-outlined text-[16px]">download</span>
                Export Report
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-12 gap-gutter flex-1 min-h-[600px]">
        <!-- Top 10 Slowest Queries Table (Span 8) -->
        <div class="col-span-12 xl:col-span-8 flex flex-col bg-surface-container border border-outline-variant rounded shadow-sm overflow-hidden h-[400px]">
            <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
                <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px] text-error">timer</span>
                    Top 10 Slowest Queries
                </h3>
                <span class="font-display-mono text-display-mono text-[10px] text-on-surface-variant">Sorted by max execution time (desc)</span>
            </div>
            <div class="flex-1 overflow-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead class="sticky top-0 bg-surface-container-high z-10 shadow-sm border-b border-outline-variant">
                        <tr>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold">Namespace</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold">Operation (Snippet)</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Max Time</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Avg Time</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Count</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/50">
                        <tr class="hover:bg-surface-variant/30 group">
                            <td class="py-cell-padding-y px-cell-padding-x">
                                <span class="font-code-block text-code-block text-secondary">payments.transactions</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x w-full max-w-0 truncate">
                                <code class="font-code-block text-code-block bg-surface-container-highest px-1.5 py-0.5 rounded text-on-surface border border-outline-variant/30">{"find": "transactions", "filter": {"status": "pending", "amount": {"$gt": 1000}}}</code>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-error">4,251ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-tertiary">1,820ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-on-surface-variant">1,402</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-variant/30 group">
                            <td class="py-cell-padding-y px-cell-padding-x">
                                <span class="font-code-block text-code-block text-secondary">users.profiles</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x w-full max-w-0 truncate">
                                <code class="font-code-block text-code-block bg-surface-container-highest px-1.5 py-0.5 rounded text-on-surface border border-outline-variant/30">{"aggregate": "profiles", "pipeline": [{"$match": {"last_login": {"$lt": ISODate(...)}}}, ...]}</code>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-error">3,104ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-on-surface">840ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-on-surface-variant">52</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-variant/30 group">
                            <td class="py-cell-padding-y px-cell-padding-x">
                                <span class="font-code-block text-code-block text-secondary">logs.system_events</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x w-full max-w-0 truncate">
                                <code class="font-code-block text-code-block bg-surface-container-highest px-1.5 py-0.5 rounded text-emerald-400 border border-outline-variant/30">{"find": "system_events", "filter": {"severity": "CRITICAL"}, "sort": {"timestamp": -1}}</code>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-tertiary">1,940ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-on-surface">450ms</span>
                            </td>
                            <td class="py-cell-padding-y px-cell-padding-x text-right">
                                <span class="font-display-mono text-display-mono text-on-surface-variant">8,912</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Index Suggestions (Span 4) -->
        <div class="col-span-12 xl:col-span-4 flex flex-col gap-gutter h-[400px]">
            <div class="flex-1 bg-surface-container border border-outline-variant rounded flex flex-col overflow-hidden">
                <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center shrink-0">
                    <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-[16px] text-secondary">add_circle</span>
                        Index Suggestions
                    </h3>
                    <span class="px-1.5 py-0.5 bg-secondary/10 text-secondary rounded text-[10px] font-bold">3 New</span>
                </div>
                <div class="flex-1 overflow-auto p-2 space-y-2">
                    <!-- Suggestion Card -->
                    <div class="bg-surface-container-highest border border-outline-variant/50 rounded p-3 flex flex-col gap-2 relative overflow-hidden group hover:border-secondary/50 transition-colors">
                        <div class="absolute top-0 right-0 w-1 bg-secondary h-full"></div>
                        <div class="flex justify-between items-start">
                            <div class="font-code-block text-code-block text-xs font-bold text-on-surface">payments.transactions</div>
                            <div class="flex items-center gap-1 text-[10px] text-tertiary bg-tertiary/10 px-1.5 py-0.5 rounded">
                                <span class="material-symbols-outlined text-[12px]">speed</span> High Impact
                            </div>
                        </div>
                        <div class="text-[11px] text-on-surface-variant leading-tight">Queries filtering by <code class="text-primary bg-background px-1 rounded">status</code> and <code class="text-primary bg-background px-1 rounded">amount</code> are performing full collection scans.</div>
                        <div class="bg-background p-1.5 rounded border border-outline-variant/30 mt-1">
                            <code class="font-code-block text-code-block text-[10px] text-secondary">{ "status": 1, "amount": -1 }</code>
                        </div>
                        <div class="mt-1 flex justify-end">
                            <button class="px-3 py-1 bg-secondary/10 hover:bg-secondary/20 text-secondary border border-secondary/30 rounded font-ui-label-sm text-[10px] transition-colors">Build Index</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Most Frequent Query Patterns (Span 12) -->
        <div class="col-span-12 bg-surface-container border border-outline-variant rounded flex flex-col h-[280px]">
            <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center shrink-0">
                <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px] text-primary">bar_chart</span>
                    Most Frequent Query Patterns
                </h3>
                <div class="flex gap-4">
                    <div class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-primary"></div><span class="text-[10px] text-on-surface-variant font-display-mono uppercase">Read Ops</span></div>
                    <div class="flex items-center gap-1.5"><div class="w-2 h-2 rounded-full bg-tertiary"></div><span class="text-[10px] text-on-surface-variant font-display-mono uppercase">Write Ops</span></div>
                </div>
            </div>
            <div class="flex-1 p-4 flex flex-col gap-3 overflow-y-auto">
                <!-- Chart Bar Row -->
                <div class="flex items-center gap-4 group">
                    <div class="w-32 shrink-0 font-code-block text-code-block text-xs text-on-surface truncate text-right" title="find: sessions">find: sessions</div>
                    <div class="flex-1 h-3 bg-surface-container-highest rounded overflow-hidden flex relative border border-outline-variant/20">
                        <!-- Pattern Gradient Bar (Read) -->
                        <div class="h-full bg-gradient-to-r from-primary/20 to-primary/60 border-r-[1.5px] border-primary" style="width: 85%;"></div>
                        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-display-mono text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">124.5k/s</span>
                    </div>
                </div>
                <!-- Chart Bar Row -->
                <div class="flex items-center gap-4 group">
                    <div class="w-32 shrink-0 font-code-block text-code-block text-xs text-on-surface truncate text-right" title="update: user_cache">update: user_cache</div>
                    <div class="flex-1 h-3 bg-surface-container-highest rounded overflow-hidden flex relative border border-outline-variant/20">
                        <!-- Pattern Gradient Bar (Write) -->
                        <div class="h-full bg-gradient-to-r from-tertiary/20 to-tertiary/60 border-r-[1.5px] border-tertiary" style="width: 62%;"></div>
                        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-display-mono text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">89.2k/s</span>
                    </div>
                </div>
                <!-- Chart Bar Row -->
                <div class="flex items-center gap-4 group">
                    <div class="w-32 shrink-0 font-code-block text-code-block text-xs text-on-surface truncate text-right" title="aggregate: metrics">aggregate: metrics</div>
                    <div class="flex-1 h-3 bg-surface-container-highest rounded overflow-hidden flex relative border border-outline-variant/20">
                        <div class="h-full bg-gradient-to-r from-primary/20 to-primary/60 border-r-[1.5px] border-primary" style="width: 45%;"></div>
                        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-display-mono text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">45.1k/s</span>
                    </div>
                </div>
                <!-- Chart Bar Row -->
                <div class="flex items-center gap-4 group">
                    <div class="w-32 shrink-0 font-code-block text-code-block text-xs text-on-surface truncate text-right" title="find: inventory">find: inventory</div>
                    <div class="flex-1 h-3 bg-surface-container-highest rounded overflow-hidden flex relative border border-outline-variant/20">
                        <div class="h-full bg-gradient-to-r from-primary/20 to-primary/60 border-r-[1.5px] border-primary" style="width: 25%;"></div>
                        <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-display-mono text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">18.9k/s</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
