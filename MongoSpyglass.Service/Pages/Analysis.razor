@page "/analysis"
@using MongoSpyglass.Service.Data
@namespace MongoSpyglass.Service.Pages
@inject TrafficMonitorService TrafficMonitor
@implements IDisposable

<main class="flex-1 overflow-auto p-container-padding flex flex-col gap-gutter">
    <div class="flex justify-between items-end mb-unit">
        <div>
            <h2 class="font-ui-header text-ui-header text-on-surface">Performance Bottlenecks</h2>
            <p class="text-on-surface-variant mt-1 text-xs">Aggregated view of high-latency operations and indexing opportunities over the last 24 hours.</p>
        </div>
        <div class="flex gap-2">
            <button class="flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-high border border-outline-variant rounded hover:bg-surface-variant transition-colors text-on-surface font-ui-label-sm text-ui-label-sm">
                <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                Last 24h
            </button>
            <button class="flex items-center gap-1.5 px-3 py-1.5 bg-primary/10 border border-primary/30 text-primary rounded hover:bg-primary/20 transition-colors font-ui-label-sm text-ui-label-sm">
                <span class="material-symbols-outlined text-[16px]">download</span>
                Export Report
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-12 gap-gutter flex-1 min-h-[600px]">
        <!-- Top 10 Slowest Queries Table (Span 8) -->
        <div class="col-span-12 xl:col-span-8 flex flex-col bg-surface-container border border-outline-variant rounded shadow-sm overflow-hidden h-[400px]">
            <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
                <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px] text-error">timer</span>
                    Top 10 Slowest Queries
                </h3>
                <span class="font-display-mono text-display-mono text-[10px] text-on-surface-variant">Sorted by max execution time (desc)</span>
            </div>
            <div class="flex-1 overflow-auto">
                <table class="w-full text-left border-collapse whitespace-nowrap">
                    <thead class="sticky top-0 bg-surface-container-high z-10 shadow-sm border-b border-outline-variant">
                        <tr>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold">Namespace</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold">Operation (Snippet)</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Max Time</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Avg Time</th>
                            <th class="py-cell-padding-y px-cell-padding-x font-ui-label-sm text-ui-label-sm text-on-surface-variant font-semibold text-right">Count</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/50">
                        @foreach (var slow in _slowestGroups)
                        {
                            <tr class="hover:bg-surface-variant/30 group">
                                <td class="py-cell-padding-y px-cell-padding-x">
                                    <span class="font-code-block text-code-block text-secondary">@slow.Namespace</span>
                                </td>
                                <td class="py-cell-padding-y px-cell-padding-x w-full max-w-0 truncate">
                                    <code class="font-code-block text-code-block bg-surface-container-highest px-1.5 py-0.5 rounded text-on-surface border border-outline-variant/30">@slow.Payload</code>
                                </td>
                                <td class="py-cell-padding-y px-cell-padding-x text-right">
                                    <span class="font-display-mono text-display-mono text-error">@slow.MaxTime.ToString("F0")ms</span>
                                </td>
                                <td class="py-cell-padding-y px-cell-padding-x text-right">
                                    <span class="font-display-mono text-display-mono text-tertiary">@slow.AvgTime.ToString("F0")ms</span>
                                </td>
                                <td class="py-cell-padding-y px-cell-padding-x text-right">
                                    <span class="font-display-mono text-display-mono text-on-surface-variant">@slow.Count</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Index Suggestions (Span 4) -->
        <div class="col-span-12 xl:col-span-4 flex flex-col gap-gutter h-[400px]">
            <div class="flex-1 bg-surface-container border border-outline-variant rounded flex flex-col overflow-hidden">
                <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center shrink-0">
                    <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-[16px] text-secondary">add_circle</span>
                        Index Suggestions
                    </h3>
                    <span class="px-1.5 py-0.5 bg-secondary/10 text-secondary rounded text-[10px] font-bold">@(_slowestGroups.Count(g => g.AvgTime > 100)) New</span>
                </div>
                <div class="flex-1 overflow-auto p-2 space-y-2">
                    @if (!_slowestGroups.Any(g => g.AvgTime > 100))
                    {
                        <div class="text-center text-on-surface-variant text-xs py-8">No high-impact suggestions yet.</div>
                    }
                    else
                    {
                        @foreach (var g in _slowestGroups.Where(g => g.AvgTime > 100).Take(3))
                        {
                            <div class="bg-surface-container-highest border border-outline-variant/50 rounded p-3 flex flex-col gap-2 relative overflow-hidden group hover:border-secondary/50 transition-colors">
                                <div class="absolute top-0 right-0 w-1 bg-secondary h-full"></div>
                                <div class="flex justify-between items-start">
                                    <div class="font-code-block text-code-block text-xs font-bold text-on-surface">@g.Namespace</div>
                                    <div class="flex items-center gap-1 text-[10px] text-tertiary bg-tertiary/10 px-1.5 py-0.5 rounded">
                                        <span class="material-symbols-outlined text-[12px]">speed</span> High Impact
                                    </div>
                                </div>
                                <div class="text-[11px] text-on-surface-variant leading-tight">Frequent slow @g.Command operations detected. Consider indexing filtered fields.</div>
                                <div class="mt-1 flex justify-end">
                                    <button class="px-3 py-1 bg-secondary/10 hover:bg-secondary/20 text-secondary border border-secondary/30 rounded font-ui-label-sm text-[10px] transition-colors">Build Index</button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Most Frequent Query Patterns (Span 12) -->
        <div class="col-span-12 bg-surface-container border border-outline-variant rounded flex flex-col h-[280px]">
            <div class="px-4 py-2 border-b border-outline-variant bg-surface-container-low flex justify-between items-center shrink-0">
                <h3 class="font-ui-label-sm text-ui-label-sm text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px] text-primary">bar_chart</span>
                    Most Frequent Query Patterns
                </h3>
            </div>
            <div class="flex-1 p-4 flex flex-col gap-3 overflow-y-auto">
                @foreach (var pattern in _frequentPatterns)
                {
                    <div class="flex items-center gap-4 group">
                        <div class="w-32 shrink-0 font-code-block text-code-block text-xs text-on-surface truncate text-right" title="@pattern.Key">@pattern.Key</div>
                        <div class="flex-1 h-3 bg-surface-container-highest rounded overflow-hidden flex relative border border-outline-variant/20">
                            <div class="h-full bg-gradient-to-r from-primary/20 to-primary/60 border-r-[1.5px] border-primary" style="width: @(pattern.Value * 100 / Math.Max(1, _totalOps))%;"></div>
                            <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] font-display-mono text-on-surface opacity-0 group-hover:opacity-100 transition-opacity">@pattern.Value ops</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@code {
    private int _totalOps => TrafficMonitor.Traffic.Count();

    private class AggregatedQuery
    {
        public string Namespace { get; set; } = "";
        public string Command { get; set; } = "";
        public string Payload { get; set; } = "";
        public double MaxTime { get; set; }
        public double AvgTime { get; set; }
        public int Count { get; set; }
    }

    private IEnumerable<AggregatedQuery> _slowestGroups => TrafficMonitor.Traffic
        .Where(t => t.DurationMs.HasValue)
        .GroupBy(t => new { t.Collection, t.Command })
        .Select(g => new AggregatedQuery
        {
            Namespace = g.Key.Collection,
            Command = g.Key.Command,
            Payload = g.First().PayloadJson,
            MaxTime = g.Max(t => t.DurationMs!.Value),
            AvgTime = g.Average(t => t.DurationMs!.Value),
            Count = g.Count()
        })
        .OrderByDescending(g => g.MaxTime)
        .Take(10);

    private IEnumerable<KeyValuePair<string, int>> _frequentPatterns => TrafficMonitor.Traffic
        .GroupBy(t => $"{t.Command}: {t.Collection}")
        .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
        .OrderByDescending(kv => kv.Value)
        .Take(5);

    protected override void OnInitialized()
    {
        TrafficMonitor.OnTrafficReceived += HandleTrafficReceived;
    }

    private async void HandleTrafficReceived()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TrafficMonitor.OnTrafficReceived -= HandleTrafficReceived;
    }
}
