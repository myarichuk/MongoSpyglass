@using MongoSpyglass.Service.Data
@using MongoSpyglass.Service.Analyzers
@inject NotificationHubService NotificationHub
@inject DialogService DialogService

<div class="flex flex-col h-full bg-surface">
    <div class="px-4 py-2 border-b border-outline-variant flex justify-between items-center shrink-0">
        <span class="font-ui-label-sm text-on-surface-variant uppercase tracking-wider">Recent Insights</span>
        @if (NotificationHub.GetAll().Count > 0)
        {
            <RadzenButton Text="Dismiss All" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@DismissAll" class="text-primary" />
        }
    </div>
    @if (NotificationHub.GetAll().Count == 0)
    {
        <div class="flex-1 flex flex-col items-center justify-center opacity-50 gap-4">
            <span class="material-symbols-outlined text-[48px]">notifications_off</span>
            <span class="font-ui-label-sm uppercase">No Notifications</span>
        </div>
    }
    else
    {
        <div class="flex-1 overflow-y-auto divide-y divide-outline-variant/30">
            @foreach (var insight in NotificationHub.GetAll())
            {
                <div class="group p-4 hover:bg-surface-container-high transition-colors cursor-pointer" @onclick="@(() => ShowDetail(insight))">
                    <div class="flex justify-between items-start mb-1">
                        <span class="font-ui-label-sm text-[10px] text-on-surface-variant uppercase tracking-wider">@insight.Category • @insight.Timestamp.ToString("HH:mm")</span>
                        <div class="flex items-center gap-2">
                            <RadzenBadge BadgeStyle="@GetBadgeStyle(insight.Level)" Text="@insight.Level" />
                            <button class="opacity-0 group-hover:opacity-100 h-6 w-6 flex items-center justify-center rounded-full hover:bg-outline-variant/20 text-on-surface-variant" 
                                    @onclick:stopPropagation="true" 
                                    @onclick="@(() => Dismiss(insight))">
                                <span class="material-symbols-outlined text-[16px]">close</span>
                            </button>
                        </div>
                    </div>
                    <div class="font-ui-header text-on-surface mb-0.5">@insight.Title</div>
                    <div class="font-ui-body text-xs text-on-surface-variant line-clamp-2">@insight.Description</div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Radzen.BadgeStyle GetBadgeStyle(string level) => level switch
    {
        "Critical" => Radzen.BadgeStyle.Danger,
        "Warning" => Radzen.BadgeStyle.Warning,
        _ => Radzen.BadgeStyle.Info
    };

    private async Task ShowDetail(MongoInsight insight)
    {
        await DialogService.OpenAsync<InsightDetail>(insight.Title, 
            new Dictionary<string, object> { { "Insight", insight } },
            new DialogOptions { Width = "700px", Height = "600px", Resizable = true, Draggable = true });
    }

    private async Task Dismiss(MongoInsight insight)
    {
        await NotificationHub.DismissAsync(insight.Id);
    }

    private async Task DismissAll()
    {
        await NotificationHub.DismissAllAsync();
    }
}
