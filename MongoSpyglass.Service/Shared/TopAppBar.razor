@using MongoSpyglass.Service.Data
@using MongoSpyglass.Service.Analyzers
@inject NotificationHubService NotificationHub
@inject DialogService DialogService
@implements IDisposable

<header class="bg-slate-900 dark:bg-[#011E29] text-sky-400 font-inter text-sm antialiased docked full-width top-0 h-12 border-b border-slate-700 flat no shadows flex justify-between items-center px-4 w-full shrink-0 z-20">
    <div class="flex items-center gap-6">
        <span class="text-lg font-bold tracking-tighter text-slate-100 hidden md:block">MongoDB Profiler</span>
        <!-- Global Search -->
        <div class="relative flex items-center group">
            <span class="material-symbols-outlined absolute left-2 text-slate-400 text-[18px] group-focus-within:text-sky-400 transition-colors">search</span>
            <input class="bg-slate-950/50 text-slate-200 border border-slate-700 rounded pl-8 pr-3 py-1 text-xs focus:outline-none focus:border-sky-400 w-64 h-[28px] transition-colors placeholder:text-slate-500" placeholder="Search clusters, dbs..." type="text"/>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <NavLink href="/settings" class="material-symbols-outlined text-slate-400 hover:bg-slate-800 transition-colors cursor-pointer active:opacity-80 p-1.5 rounded text-[20px]">settings</NavLink>
        <span class="material-symbols-outlined text-slate-400 hover:bg-slate-800 transition-colors cursor-pointer active:opacity-80 p-1.5 rounded text-[20px]">help</span>
        
        <button class="p-1.5 text-slate-400 hover:bg-slate-800 transition-colors rounded cursor-pointer active:opacity-80 relative" @onclick="@ShowNotifications">
            <span class="material-symbols-outlined text-[20px]">notifications</span>
            @if (NotificationHub.UnreadCount > 0)
            {
                <span class="absolute top-1 right-1 min-w-[14px] h-[14px] bg-error text-white text-[9px] font-bold rounded-full flex items-center justify-center px-0.5">
                    @NotificationHub.UnreadCount
                </span>
            }
        </button>

        <div class="ml-3 w-7 h-7 rounded-full overflow-hidden border border-slate-700 bg-slate-800 cursor-pointer">
            <img alt="DB Admin Profile" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDSsPEHOrI81NFXzW64DYsbeDzLk_E4WAN8DqYrgpJFhU4AiRixb5kExMCyxcja8IIPbxsXP4jRS1usQ1BLCKTsNDzHBgnhKASx52HvJSH_zS-imn5ArN_oiO8-UUfDWWJMu18f1c_byrKaF6SRDJYyetpLgu5PL-W7WyOdvtKO4DVqxlxAnaMq03DYDeP-JCdkXQqWNd4IMCUIt_MuBIn0sYzQ3B0Uqe4Acx3m7d_5S6LWILLAws0NacyisnSqP_KIFRC38OLYl1k"/>
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        NotificationHub.OnNotificationsUpdated += HandleUpdate;
        // Start a background timer to poll for new insights every 2 seconds
        _ = PollInsights();
    }

    private async Task PollInsights()
    {
        while (true)
        {
            await Task.Delay(2000);
            NotificationHub.Refresh();
        }
    }

    private async void HandleUpdate()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowNotifications()
    {
        await DialogService.OpenAsync<NotificationList>("Notifications", null, new DialogOptions { Width = "500px", Height = "600px" });
        NotificationHub.MarkAllAsRead();
    }

    public void Dispose()
    {
        NotificationHub.OnNotificationsUpdated -= HandleUpdate;
    }
}
