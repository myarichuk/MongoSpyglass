<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Separate process so the fake does not share the proxy process's thread pool/GC, like a real mongod -->
    <PackageReference Include="Mongo.Fakes.Server" Version="0.12.0" />
  </ItemGroup>
</Project>
