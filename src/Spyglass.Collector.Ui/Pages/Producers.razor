@page "/producers"
@inherits LoadPage

<PageTitle>Topology &amp; producers · Spyglass</PageTitle>
<div class="p-container-padding flex flex-col gap-4 max-w-6xl">
    <h1 class="h">Topology &amp; producers</h1>
    <ErrorBanner Error="@Error" OnRetry="Reload" />
    @if (Loaded && Error == null && _rows.Length == 0) { <p class="text-muted">No producer has sent anything yet.</p> }
    @foreach (var p in _rows)
    {
        <section class="card p-container-padding flex flex-col gap-2" aria-label="@p.Src">
            <div class="flex flex-wrap items-baseline gap-3">
                <span class="badge bg-surface-3">@p.Kind</span>
                <span class="mono">@p.Src</span>
                <span class="text-muted">@p.Version · schema @p.Schema</span>
                <span class="ml-auto text-ui-label-sm @(_now - p.LastSeen > 120_000_000 ? "text-warn" : "text-muted")">last seen @Fmt.Ago(p.LastSeen, _now) ago</span>
            </div>
            @if (p.Topology != null)
            {
                <p>@p.Topology @(p.SetName != null ? $"({p.SetName})" : "") · capture values: <span class="mono">@p.Values</span> · compression: <span class="mono">@p.Compression</span></p>
                var hasCerts = p.Members.ValueKind == JsonValueKind.Array && p.Members.EnumerateArray().Any(m => m.TryGetProperty("cert", out _));
                <table class="tbl"><thead><tr><th>listener (member)</th><th>upstream</th>@if (hasCerts) { <th>server cert</th> }</tr></thead>
                    <tbody>
                        @if (p.Members.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var m in p.Members.EnumerateArray())
                            {
                                <tr><td class="mono">@m.GetProperty("member").GetString()</td><td class="mono">@m.GetProperty("upstream").GetString()</td>
                                    @if (hasCerts) { <td>@if (m.TryGetProperty("cert", out var cert)) { <span class="mono">@(cert.TryGetProperty("issuer", out var iss) ? iss.GetString() : "")</span> <CertExpiry Cert="cert" /> }</td> }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            <TlsBlock Tls="p.Tls" />
            @if (p.Kind != "proxy" && (p.Runtime ?? p.Driver ?? p.Host) != null)
            {
                <p>@p.App @p.AppVersion · <span class="mono">@p.Runtime</span> · <span class="mono">@p.Driver</span> · @p.Host @(p.Pid is { } pid ? $"pid {pid}" : "")</p>
            }
            @if (p.Join is { } j)
            {
                <p>
                    join rate <strong class="@(j.Rate is < 0.999 ? "text-warn" : "text-ok")">@(j.Rate is { } r ? r.ToString("P2") : "–")</strong>
                    · @j.Joined of @j.Cmds commands joined · @j.Orphans orphaned
                    @if (j.Conflicts > 0) { <span class="text-bad"> · @j.Conflicts conflicts</span> }
                    @if (j.SkewUs is { } sk) { <span class="@(Math.Abs(sk) > 1_000_000 ? "text-warn" : "text-muted")"> · clock @(sk >= 0 ? "+" : "−")@Fmt.Us(Math.Abs(sk)) vs the proxy</span> }
                </p>
            }
            <p class="text-ui-label-sm text-muted">@p.Records records · @p.Rejected rejected · @p.ClockSkewed clock-skewed
                @if (p.Dropped.Any(kv => kv.Value > 0)) { <span> · dropped at the producer: @string.Join(", ", p.Dropped.Where(kv => kv.Value > 0).Select(kv => $"{kv.Key} {kv.Value}"))</span> }
            </p>
        </section>
    }
    <p class="text-ui-label-sm text-muted">Join rate: commands the exporter reported that found their proxy operation (02 §6). Orphans are commands sent without a proxy key (a server reached directly) or whose operation never arrived.</p>
</div>

@code {
    private ProducerDto[] _rows = [];
    private long _now;

    protected override TimeSpan? RefreshEvery => TimeSpan.FromSeconds(10);

    protected override async Task LoadAsync(CancellationToken ct)
    {
        var rows = await Api.Producers(ct);
        ct.ThrowIfCancellationRequested();
        (_rows, _now) = (rows, Fmt.NowUs());
    }
}
