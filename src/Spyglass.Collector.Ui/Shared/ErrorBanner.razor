@if (Error != null)
{
    <div class="m-container-padding flex items-center gap-3 rounded-lg border border-bad/50 bg-bad/10 px-3 py-2 text-bad" role="alert">
        <span>@Error</span>
        @if (OnRetry.HasDelegate) { <button class="btn ml-auto" @onclick="OnRetry">Retry</button> }
    </div>
}
@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
