<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>spyglass-proxy</AssemblyName>
    <RootNamespace>Spyglass.Proxy</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 01 §1: no runtime NuGet dependencies. Do not add PackageReferences to this project. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Spyglass.Proxy.Tests" />
  </ItemGroup>

</Project>
