{
  "description": "03 §4.3: every per-command row.",
  "cases": [
    {
      "name": "find-full",
      "rule": "§4.3 find: filter, sort, projection, limit/skip/batchSize presence, hint, collation.locale",
      "command": "find",
      "db": "shop",
      "coll": "orders",
      "cmd": {
        "find": "orders",
        "filter": {
          "status": "A"
        },
        "sort": {
          "ts": -1,
          "_id": 1
        },
        "projection": {
          "a": 1,
          "_id": 0
        },
        "limit": 10,
        "skip": 20,
        "batchSize": 5,
        "hint": {
          "status": 1
        },
        "collation": {
          "locale": "fr",
          "strength": 2
        },
        "$db": "shop"
      },
      "expected": {
        "shape": {
          "batchSize": "?",
          "cmd": "find",
          "coll": "orders",
          "collation": {
            "locale": "fr"
          },
          "db": "shop",
          "filter": {
            "status": "?string"
          },
          "hint": [
            [
              "status",
              1
            ]
          ],
          "limit": "?",
          "projection": {
            "_id": 0,
            "a": 1
          },
          "skip": "?",
          "sort": [
            [
              "ts",
              -1
            ],
            [
              "_id",
              1
            ]
          ]
        },
        "shapeHash": "d41d966aec954a2d",
        "valueHash": "d74565ca09ead045",
        "inCardinality": 0
      }
    },
    {
      "name": "aggregate",
      "rule": "§4.3 aggregate: $match → normFilter, $sort kept, $group/_id structure with tags, accumulators kept, $limit/$skip → ?, unknown stages tagged",
      "command": "aggregate",
      "db": "shop",
      "coll": "orders",
      "cmd": {
        "aggregate": "orders",
        "pipeline": [
          {
            "$match": {
              "status": "A",
              "qty": {
                "$gt": 5
              }
            }
          },
          {
            "$sort": {
              "ts": -1
            }
          },
          {
            "$group": {
              "_id": {
                "c": "$customer",
                "y": {
                  "$year": "$ts"
                }
              },
              "total": {
                "$sum": "$amount"
              },
              "n": {
                "$sum": 1
              }
            }
          },
          {
            "$project": {
              "total": 1,
              "big": {
                "$gt": [
                  "$total",
                  100
                ]
              }
            }
          },
          {
            "$skip": 5
          },
          {
            "$limit": 10
          },
          {
            "$unwind": "$items"
          },
          {
            "$addFields": {
              "k": "constant"
            }
          }
        ],
        "cursor": {},
        "$db": "shop"
      },
      "expected": {
        "shape": {
          "cmd": "aggregate",
          "coll": "orders",
          "db": "shop",
          "pipeline": [
            {
              "$match": {
                "qty": {
                  "$gt": "?number"
                },
                "status": "?string"
              }
            },
            {
              "$sort": [
                [
                  "ts",
                  -1
                ]
              ]
            },
            {
              "$group": {
                "_id": {
                  "c": "$customer",
                  "y": {
                    "$year": "$ts"
                  }
                },
                "n": {
                  "$sum": "?number"
                },
                "total": {
                  "$sum": "$amount"
                }
              }
            },
            {
              "$project": {
                "big": {
                  "$gt": [
                    "$total",
                    "?number"
                  ]
                },
                "total": 1
              }
            },
            {
              "$skip": "?"
            },
            {
              "$limit": "?"
            },
            {
              "$unwind": "$items"
            },
            {
              "$addFields": {
                "k": "?string"
              }
            }
          ]
        },
        "shapeHash": "3d19afab9a1f2244",
        "valueHash": "e2664df6b3f869e1",
        "inCardinality": 0
      }
    },
    {
      "name": "aggregate-lookup",
      "rule": "§4.3 $lookup keeps from/localField/foreignField/as, its sub-pipeline normalized",
      "command": "aggregate",
      "db": "shop",
      "coll": "orders",
      "cmd": {
        "aggregate": "orders",
        "pipeline": [
          {
            "$lookup": {
              "from": "customers",
              "localField": "cid",
              "foreignField": "_id",
              "as": "c"
            }
          },
          {
            "$lookup": {
              "from": "items",
              "let": {
                "o": "$_id"
              },
              "pipeline": [
                {
                  "$match": {
                    "sku": "x"
                  }
                },
                {
                  "$limit": 3
                }
              ],
              "as": "i"
            }
          }
        ],
        "cursor": {},
        "$db": "shop"
      },
      "expected": {
        "shape": {
          "cmd": "aggregate",
          "coll": "orders",
          "db": "shop",
          "pipeline": [
            {
              "$lookup": {
                "as": "c",
                "foreignField": "_id",
                "from": "customers",
                "localField": "cid"
              }
            },
            {
              "$lookup": {
                "as": "i",
                "from": "items",
                "let": {
                  "o": "$_id"
                },
                "pipeline": [
                  {
                    "$match": {
                      "sku": "?string"
                    }
                  },
                  {
                    "$limit": "?"
                  }
                ]
              }
            }
          ]
        },
        "shapeHash": "0a7778cc259818d5",
        "valueHash": "719885d43efb0e56",
        "inCardinality": 0
      }
    },
    {
      "name": "update",
      "rule": "§4.3 update: per statement q, u (operator → field → tag), upsert, multi; statements deduplicated",
      "command": "update",
      "db": "shop",
      "coll": "orders",
      "cmd": {
        "update": "orders",
        "updates": [
          {
            "q": {
              "_id": 1
            },
            "u": {
              "$set": {
                "status": "B",
                "n": 2
              },
              "$inc": {
                "v": 1
              }
            }
          },
          {
            "q": {
              "_id": 2
            },
            "u": {
              "$set": {
                "status": "C",
                "n": 3
              },
              "$inc": {
                "v": 1
              }
            }
          },
          {
            "q": {
              "status": "A"
            },
            "u": {
              "$unset": {
                "x": ""
              }
            },
            "upsert": true,
            "multi": true
          }
        ],
        "$db": "shop"
      },
      "expected": {
        "shape": {
          "cmd": "update",
          "coll": "orders",
          "db": "shop",
          "updates": [
            {
              "q": {
                "_id": "?number"
              },
              "u": {
                "$inc": {
                  "v": "?number"
                },
                "$set": {
                  "n": "?number",
                  "status": "?string"
                }
              }
            },
            {
              "multi": true,
              "q": {
                "status": "?string"
              },
              "u": {
                "$unset": {
                  "x": "?string"
                }
              },
              "upsert": true
            }
          ]
        },
        "shapeHash": "a2ba928428a56007",
        "valueHash": "babfba04dc3c43a1",
        "inCardinality": 0
      }
    },
