{
  "description": "03 §4.2: every operator rule of normFilter.",
  "cases": [
    {
      "name": "or-sorted-deduplicated",
      "rule": "§4.2 $or: clauses normalized, sorted by canonical form, deduplicated",
      "command": "find",
      "db": "shop",
      "coll": "orders",
      "cmd": {
        "find": "orders",
        "filter": {
          "$or": [
            {
              "b": 1
            },
            {
              "a": "x"
            },
            {
              "b": 2
            }
          ]
        },
        "$db": "shop"
      },
      "expected": {
        "shape": {
          "cmd": "find",
          "coll": "orders",
          "db": "shop",
          "filter": {
            "$or": [
              {
                "a": "?string"
              },
              {
                "b": "?number"
              }
            ]
          }
        },
        "shapeHash": "e3e3d95f51614cdf",
        "valueHash": "33434d93148a242a",
        "inCardinality": 0
      }
    },
